<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(ClientTargetFramework)</TargetFramework>
    <AssemblyName>CommunityToolkit.AI.Chat</AssemblyName>
    <RootNamespace>CommunityToolkit.AI.Chat</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CommunityToolkit.AI.Chat</PackageId>
    <Description>Local chat models for Windows apps through Microsoft.Extensions.AI IChatClient. Inference runs out-of-process in the shared CommunityToolkit.AI runtime.</Description>
    <PackageTags>ai;local;chat;llm;IChatClient;windows</PackageTags>
    <MinVerTagPrefix>chat-v</MinVerTagPrefix>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ProtocolDir)Chat\**\*.cs" LinkBase="Protocol\Chat" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task packages accept any Core 1.x (spec 4.1). -->
    <ProjectReference Include="..\Core\CommunityToolkit.AI.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
