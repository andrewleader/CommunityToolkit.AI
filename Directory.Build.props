<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CS1573</NoWarn>
    <Authors>CommunityToolkit.AI contributors</Authors>
    <Company>CommunityToolkit.AI</Company>
    <Copyright>Copyright (c) CommunityToolkit.AI contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://andrewleader.github.io/CommunityToolkit.AI/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andrewleader/CommunityToolkit.AI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ProtocolDir>$(RepoRoot)src\Protocol\</ProtocolDir>
    <!-- Client libraries target the oldest supported LTS; runtime processes target the newest LTS. -->
    <ClientTargetFramework>net8.0</ClientTargetFramework>
    <RuntimeTargetFramework>net10.0</RuntimeTargetFramework>
  </PropertyGroup>
</Project>
